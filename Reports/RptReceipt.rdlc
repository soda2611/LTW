      <Textbox Name="txtStudentInfo">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>• Họ và tên học viên: </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!StudentFullName.Value, "ReceiptDataSet")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontWeight>Bold</FontWeight>
                  <Color>#0D47A1</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>    (Tài khoản: </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!StudentUsername.Value, "ReceiptDataSet")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                </Style>
              </TextRun>
              <TextRun>
                <Value>)</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>• Email: </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!StudentEmail.Value, "ReceiptDataSet")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                </Style>
              </TextRun>
              <TextRun>
                <Value>    |  Số điện thoại: </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!StudentPhone.Value, "ReceiptDataSet")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>1.85in</Top>
        <Left>0.7in</Left>
        <Height>0.5in</Height>
        <Width>6.3in</Width>
      </Textbox>

                    <Value>="• Khuyến mại / Voucher (" &amp; IIF(String.IsNullOrEmpty(First(Fields!VoucherCode.Value, "ReceiptDataSet")), "Không áp dụng", First(Fields!VoucherCode.Value, "ReceiptDataSet")) &amp; "):"</Value>

          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Mã biên lai: #REC-" &amp; CStr(First(Fields!EnrollmentId.Value, "ReceiptDataSet")) &amp; "  |  Ngày lập: " &amp; Format(First(Fields!EnrollDate.Value, "ReceiptDataSet"), "dd/MM/yyyy HH:mm")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                  <Color>#666666</Color>
                </Style>
              </TextRun>

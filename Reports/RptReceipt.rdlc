      <Textbox Name="txtSchoolName">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>TRUNG TÂM ĐÀO TẠO CÔNG NGHỆ THÔNG TIN &amp; LẬP TRÌNH VIÊN</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#1B3A6B</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Hệ thống Đăng ký &amp; Quản lý Khóa học Trực tuyến | Hotline: 0901.234.567</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Color>#555555</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.2in</Top>
        <Left>0.5in</Left>
        <Height>0.45in</Height>
        <Width>6.5in</Width>
      </Textbox>
      <Line Name="lineHeader">
        <Top>0.72in</Top>
        <Left>0.5in</Left>
        <Height>0in</Height>
        <Width>6.5in</Width>

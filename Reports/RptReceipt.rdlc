      <Textbox Name="txtTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>BIÊN LAI THU HỌC PHÍ VÀ XÁC NHẬN GHI DANH</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>15pt</FontSize>

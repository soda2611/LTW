<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="txtSchoolName">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!CenterName.Value</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#1B3A6B</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Hệ thống Đăng ký &amp; Quản lý Khóa học Trực tuyến | Hotline: 0901.234.567</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Color>#555555</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.2in</Top>
        <Left>0.5in</Left>
        <Height>0.45in</Height>
        <Width>9.5in</Width>
      </Textbox>
      <Line Name="lineHeader">
        <Top>0.72in</Top>
        <Left>0.5in</Left>
        <Height>0in</Height>
        <Width>9.5in</Width>
        <Style>
          <Border>
            <Color>#1B3A6B</Color>
            <Style>Solid</Style>
            <Width>1.5pt</Width>
          </Border>
        </Style>
      </Line>
      <Textbox Name="txtTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>BÁO CÁO DANH SÁCH HỌC VIÊN ĐĂNG KÝ THEO KHÓA HỌC</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>15pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#0D47A1</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Thời điểm lập: " &amp; Format(Now(), "dd/MM/yyyy HH:mm:ss") &amp; "  |  Bộ lọc: " &amp; Parameters!ReportFilter.Value</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                  <Color>#666666</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.85in</Top>
        <Left>0.5in</Left>
        <Height>0.6in</Height>
        <Width>9.5in</Width>
      </Textbox>
